<?xml version="1.0" encoding="utf-8"?>
<!--
  حساب لند — پوسته‌ی TWA روی همان PWA.

  اینجا هیچ کد برنامه‌ای نیست و عمداً هم نیست: کل اپ همان سایت است.
  چیزی که این فایل می‌گوید فقط این است که «کروم، این آدرس را تمام‌صفحه
  و بدون نوار آدرس باز کن».

  به همین دلیل هر قابلیتی که به سایت اضافه شود، همان لحظه در اپ هم هست
  و هیچ APK تازه‌ای لازم ندارد.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- برای بررسی اینکه شبکه هست یا نه (کتابخانه استفاده می‌کند) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ⛔ ثبت خودکار از پیامک بانک — تنها دلیلی که این اپ کدِ بومی دارد.
         نه PWA و نه TWA به SMS دسترسی ندارند و هیچ API وبی هم برایش نیست
         (Web OTP فقط کدِ ورودِ همان دامنه را می‌دهد)، پس این کار **فقط**
         از سمت اندروید ممکن است.

         ⚠ مجوزِ خطرناک است: کاربر باید هم داخل اپ کلیدش را بزند هم مجوزِ
           اندروید را بدهد. پیش‌فرض خاموش.

         ⚠ این اپ از راه GitHub Release نصب می‌شود، نه Google Play، پس
           سیاستِ SMS ی پلی (که برای این مجوز تأییدیه می‌خواهد) اینجا
           موضوعیت ندارد. اگر روزی به پلی رفت، باید درخواستِ استثنا داد. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>

    <!-- ⛔ خواندنِ صندوقِ پیامک — و این **تنها** مجوزِ تازه‌ای است که
         خواسته شد، با اینکه درخواستِ مالکِ نصب «تمام اجازه‌های
         سخت‌افزاری» بود.

         دلیلش همان قاعده‌ی خودِ این پروژه است: «مجوزی که لازم نیست
         نباید خواسته شود». دوربین، موقعیت مکانی، میکروفون، مخاطبین و
         حافظه هیچ‌کدام به پیامک ربطی ندارند؛ اعلامشان فقط کاربر را
         می‌ترساند و بازبینِ فروشگاه را. آنچه «دسترسی کامل به پیامک»
         واقعاً کم داشت همین یکی بود.

         ⛔ و چیزی که با آن ممکن می‌شود، یک خرابیِ واقعی را می‌بندد:
            `RECEIVE_SMS` فقط پیامکِ **تازه‌رسیده** را می‌دهد. پس هر
            پیامکی که پیش از نصبِ اپ، یا در مدتی که رام جلوی گیرنده را
            گرفته بود، یا وقتی کلید خاموش بود آمده باشد **برای همیشه
            از دست می‌رفت** — و کاربر فقط می‌دید «چیزی خوانده نشد».
            حالا صفحه‌ی تنظیم یک دکمه دارد که صندوق را می‌گردد.

         ⛔ ولی صندوق **هرگز خودکار خوانده نمی‌شود**: نه در اجرای اپ، نه
            در پس‌زمینه، نه از گیرنده. فقط با تپِ خودِ کاربر روی همان
            دکمه. قاعده ۱۹ در `test_api_contract.php` همین را می‌سنجد.

         ⚠ مثل `RECEIVE_SMS` این هم مجوزِ محدودشده‌ی گوگل‌پلی است و
           همان‌جا هم نوشته شده که این اپ از پلی پخش نمی‌شود. -->
    <uses-permission android:name="android.permission.READ_SMS"/>

    <!-- ⛔ اندروید ۱۳ به بالا: **اعلان نشان دادن هم مجوز می‌خواهد**، و
         نوشتنِ آن اینجا کافی نیست. تا وقتی اپ آن را در زمانِ اجرا
         نخواهد، `nm.notify()` بی‌هیچ خطایی اجرا می‌شود و هیچ اعلانی
         دیده نمی‌شود — یعنی کاربر مجوزِ خواندنِ پیامک را داده، پیامک هم
         خوانده می‌شود، و بازهم هیچ اتفاقی نمی‌افتد. `SmsSetupActivity`
         آن را کنارِ همان مجوزِ پیامک می‌خواهد و حالتِ «اعلان بسته است»
         را جدا نشان می‌دهد.

         ⚠ فقط وقتی خواسته می‌شود که ثبت خودکار روشن شود: تنها چیزی که
           این اپ اعلان می‌کند همان پیامکِ بانک است، پس بدونِ آن قابلیت
           این مجوز واقعاً لازم نیست. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- اندروید ۱۱ به بالا: بدون این، اپ نمی‌تواند ببیند کدام مرورگر
         نصب است و TWA بی‌سروصدا به حالت مرورگر معمولی می‌افتد. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.HesabLand">

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">

            <!-- آدرسی که باز می‌شود؛ مقدارش از build.gradle.kts می‌آید -->
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="${launchUrl}"/>

            <!-- رنگ نوار وضعیت، هم‌رنگ theme_color در manifest.php -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary"/>
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/colorPrimary"/>

            <!-- ⚠ صفحه‌ی راه‌اندازیِ تصویری عمداً اضافه نشده.
                 کتابخانه برای آن به یک FileProvider و فایل filepaths.xml
                 هم نیاز دارد تا تصویر را به کروم بدهد — سه قطعه‌ی به‌هم‌
                 وابسته که هیچ‌کدامشان را اینجا نمی‌شود آزمود. به‌جایش
                 زمینه‌ی تم تیره است، پس تا آمدنِ اولین فریمِ کروم یک
                 صفحه‌ی تیره دیده می‌شود، نه سفیدیِ ناگهانی. -->

            <!-- ⛔ `MAIN`/`LAUNCHER` **باید همین‌جا بماند** — و این یک
                 بار برداشته شد و پس داده شد.
                 برای «پرسیدنِ مجوزِ پیامک در اولین اجرا» به
                 `SmsSetupActivity` منتقل شده بود. کار می‌کرد، ولی
                 هزینه‌اش را **هر** بار باز کردنِ اپ می‌داد: یک پنجره‌ی
                 اضافه پیش از کروم، و کاربر «چند بار رفرش شدن و صفحه‌ی
                 سفید» می‌دید. مجوز یک بار پرسیده می‌شود، اپ هزار بار
                 باز می‌شود.
                 راهِ درستِ مجوز، لینکِ `intent://` از پروفایل است —
                 پایین‌تر روی `SmsSetupActivity`. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ⚠ این بخش همان چیزی است که «تأیید» را ممکن می‌کند.
                 اندروید فایل https://hesab.stland.ir/.well-known/assetlinks.json
                 را می‌خواند و اثر انگشت امضای این اپ را با آن می‌سنجد.
                 اگر نخواند یا نخواند، نوار آدرس بالای صفحه می‌ماند. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${hostName}"/>
            </intent-filter>
        </activity>

        <!-- ⛔ گیرنده‌ی پیامکِ بانک.
             `exported="true"` لازم است چون فرستنده‌اش خودِ سیستم است، نه
             اپ. `android:priority` بالا نیست: ما پیامک را **نمی‌بلعیم** و
             هیچ `abortBroadcast()` ای در کار نیست — پیامک مثل همیشه به
             اپِ پیام‌رسانِ خودِ کاربر هم می‌رسد. -->
        <receiver
            android:name=".BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- ⛔ صفحه‌ی روشن/خاموش کردنِ همان قابلیت.
             از داخلِ سایت نمی‌شود مجوزِ اندروید گرفت، پس این تنها راهش
             است. از خودِ سایت با یک لینکِ `intent://` باز می‌شود.

             ⛔ و `LAUNCHER` اینجا **نیست** — یک بار بود و پس گرفته شد.
                این صفحه فقط از لینکِ `intent://` پروفایل باز می‌شود.
                دلیلش بالای `LauncherActivity` نوشته شده: درِ ورودیِ اپ
                کردنش یعنی هر بار باز کردنِ اپ یک پنجره‌ی اضافه، برای
                چیزی که یک بار لازم است.

             ⚠ `android:noHistory` عمداً **گذاشته نشد**، هرچند برای یک
               صفحه‌ی واسط طبیعی به نظر می‌رسد: با آن، اکتیویتی هنگام
               بالا آمدنِ دیالوگِ مجوز `finish` می‌شود و
               `onRequestPermissionsResult` هرگز صدا زده نمی‌شود — یعنی
               کاربر «اجازه» را می‌زند و اپ همچنان خاموش می‌ماند. -->
        <activity
            android:name=".SmsSetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HesabLand">
            <intent-filter>
                <action android:name="ir.stland.hesabland.SMS_SETUP"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
            </intent-filter>
        </activity>

        <!-- سرویسی که کروم برای نگه داشتن اتصال TWA لازم دارد.
             ⛔ و همان است که اعلانِ سایت (Web Push) را **به نامِ خودِ اپ**
             نشان می‌دهد، نه به نامِ کروم: «مثل سایر اپ‌ها». SMALL_ICON
             آیکونِ سفیدِ نوارِ وضعیت است. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification_icon"/>
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </service>

        <!-- ⛔ اندروید ۱۳ به بالا: وقتی سایت داخلِ اپ «اجازه‌ی اعلان» می‌خواهد
             (دکمه‌ی «روشن کردنِ اعلان روی گوشی» در پروفایل)، کتابخانه همین
             صفحه را باز می‌کند تا **مجوزِ خودِ اپ** (POST_NOTIFICATIONS)
             پرسیده شود. بدونِ آن، سایت «denied» می‌گرفت و هیچ پرسشی دیده
             نمی‌شد. (در androidbrowserhelper 2.5.0 هست؛ در الگوی bubblewrap
             هم دقیقاً همین خط است.) -->
        <activity android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"/>
    </application>
</manifest>
